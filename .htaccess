# Coronacion Payroll — web server rules (Apache / LiteSpeed, e.g. Hostinger)

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (phones only allow GPS on https). Skipped on localhost so XAMPP keeps working.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Source code, templates, SQL and CLI tools are never served directly; only index.php and assets/uploads are public.
    RewriteRule ^(app|database|tools|views|\.git)(/|$) - [F,L]
</IfModule>

# Hidden files (.env, .gitignore, .git…) and dumps/backups.
<FilesMatch "^\.|\.(sql|md|log|bak|ini|sh|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>
